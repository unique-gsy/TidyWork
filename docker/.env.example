# ============================================================================
# TidyWork × DSH 一键部署 · 数据目录自定义
# 用法：复制本文件为 .env 后修改，无需改 docker-compose.yml：
#       cp .env.example .env
# 说明：docker-compose.yml 中所有宿主机数据路径都读 ${TIDYWORK_DATA_DIR}，
#       未设置时回退到下面的默认值（Mac 上默认 /Users/guosy/Documents/TidyWork）。
# 注意：改 .env 后需重新创建容器才生效：docker compose up -d
# ============================================================================

# 所有个人数据的宿主机根目录（其下自动建 data/ 与 dsh-log/）
TIDYWORK_DATA_DIR=/Users/guosy/Documents/TidyWork
