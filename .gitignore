# 密钥与本地数据不入库
.env
data/
*.log
.DS_Store
__pycache__/
*.pyc

# 邮箱凭据（只会出现在数据目录，这里再兜一层）
mail/config.ini
config.ini
!*/config.example.ini

# 构建产物与历史备份不入库
dist/
backups/
node_modules/
*.zip

# 含真实工作数据的本机截图（公开仓库只放脱敏图 docs/shots/）
docs/shots-local/

# Vditor 运行时资源必须进库：打包脚本少了它就直接失败，克隆后补不回来
!tidywork-plugin/lib/vendor/
!tidywork-plugin/lib/vendor/**

# share-desktop 下的 vendor 由打包脚本从 tidywork-plugin 复制，不入库
share-desktop/plugin/lib/vendor/
