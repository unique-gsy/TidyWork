# 复制为 .env 后填写。不要提交 .env 到 Git（含密钥）。

# DeepSeek 凭据（二选一）：
# A. API Key（可选）：https://platform.deepseek.com 获取
# B. DeepSeek 账号登录：留空，启动后打开 http://localhost:3080（地址见 data/context/dsh-web-url.txt），
#    在 Models 页登录 DeepSeek 账号即可，凭据自动保存，无需粘贴 Key
DEEPSEEK_API_KEY=

# 可选：DSH Web 端口（默认 3080）
DSH_WEB_PORT=3080

# 可选：数据目录（默认 ./data，项目目录下）
TIDYWORK_DATA_DIR=./data
