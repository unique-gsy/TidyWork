# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交。

# DeepSeek 凭据（二选一）：
# A. API Key：https://platform.deepseek.com 获取，填到下面
# B. 账号登录：留空。启动后打开带 token 的地址，
#    在 Models 页登录 DeepSeek 账号即可，凭据自动存进 data/dsh/.credentials.yaml
DEEPSEEK_API_KEY=

# DSH Web 端口（宿主机），默认 3080
DSH_WEB_PORT=3080

# 数据目录（默认项目下的 ./data），可整体改到别处
TIDYWORK_DATA_DIR=./data
